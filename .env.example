MYSQL_DATABASE=creator
MYSQL_USER=creator
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-another-local-password
DB_MAX_POOL_SIZE=8
DB_CONNECTION_TIMEOUT_MS=5000
RABBITMQ_USER=creator
RABBITMQ_PASSWORD=replace-with-local-mq-password
UPLOAD_ENABLED=false
PROCESSING_DISPATCH_ENABLED=false
MEDIA_ENABLED=false
MEDIA_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MEDIA_LINK_SECONDS=60
STORAGE_REGION=us-east-1
FFPROBE_PATH=replace-with-absolute-native-ffprobe-path
FFMPEG_PATH=replace-with-absolute-native-ffmpeg-path
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=creator-private
STORAGE_ACCESS_KEY=replace-with-app-access-key
STORAGE_SECRET_KEY=replace-with-app-secret-key
STORAGE_INCOMPLETE_UPLOAD_CLEANUP=MINIO_DEFAULT
HTTP_MAX_JSON_BYTES=1048576
WORKER_DB_MAX_POOL_SIZE=2
