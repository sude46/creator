{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@upstash/context7-opencode"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp"
        ],
        "environment": {
          "PATH": "{env:HOME}/.local/share/node22/bin:/usr/local/bin:/usr/bin:/bin"
        }
      }
    }
  }
}
